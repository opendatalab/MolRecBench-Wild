+        self.model = self.create_hf_model(
+            self.ChemDFMMMForPreTraining, 
+            self.model_path, 
+            self.tokenizer,
+            device_map=self.device_map
+        ).half()
+        
+        if self.device_map is None:
+            self.model = self.model.to(self.device)
+        self.model.eval()
+        
+        self._model_loaded = True
+        logger.info("ChemDFM-X model loaded successfully")
+    
+    def download_image_from_url(self, url: str, dest_dir: str = None) -> str:
+        """
+        Download an image from URL to a temporary file.
+        
+        Args:
+            url: URL of the image
+            dest_dir: Destination directory (optional, uses temp dir if not provided)
+            
+        Returns:
+            Local file path of the downloaded image
+        """
+        if dest_dir is None:
+            dest_dir = tempfile.gettempdir()
+        
+        # Create a unique filename based on URL
+        url_hash = hashlib.md5(url.encode()).hexdigest()
+        file_extension = os.path.splitext(url.split('?')[0])[1] or '.png'
+        temp_filename = f"chemdfm_{url_hash}{file_extension}"
+        temp_path = os.path.join(dest_dir, temp_filename)
+        
+        # Download if not already downloaded
+        if not os.path.exists(temp_path):
+            logger.info(f"Downloading image from {url}")
+            try:
+                headers = {
+                    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
+                }
+                response = requests.get(url, timeout=30, headers=headers)
+                response.raise_for_status()
+                with open(temp_path, 'wb') as f:
+                    f.write(response.content)
+                logger.info(f"Downloaded image to {temp_path}")
+            except Exception as e:
+                logger.error(f"Failed to download image from {url}: {e}")
+                raise
+        else:
+            logger.info(f"Using cached image: {temp_path}")
+        
+        return temp_path
+    
+    def preprocess_message(self, message: List[dict], dataset=None) -> dict:
+        """
+        Preprocess message to extract images and text.
+        Handles both local paths and URLs.
+        
+        Args:
+            message: List of message dictionaries with 'type' and 'value' keys
+            dataset: Dataset name (optional)
+            
+        Returns:
+            Dictionary with 'text' and 'image_paths' keys
+        """
+        text_parts = []
+        image_paths = []
+        
+        for item in message:
+            if item['type'] == 'text':
+                text_parts.append(item['value'])
+            elif item['type'] == 'image':
+                image_path = item['value']
+                
+                # Check if it's a URL or local path
+                if image_path.startswith('http://') or image_path.startswith('https://'):
+                    # Download from URL
+                    try:
+                        local_path = self.download_image_from_url(image_path)
+                        image_paths.append(local_path)
+                    except Exception as e:
+                        logger.error(f"Failed to download image from URL: {image_path}")
+                        logger.error(f"Error: {e}")
+                        continue
+                # Local path
+                elif os.path.exists(image_path):
+                    image_paths.append(image_path)
+                else:
+                    logger.warning(f"Image file not found: {image_path}")
+        
+        return {
+            'text': ' '.join(text_parts) if text_parts else '',
+            'image_paths': image_paths
+        }
+    
+    def generate_inner(self, message, dataset=None):
+        """
+        Generate response from message (required by BaseModel).
+        
+        Args:
+            message: Input message (str, dict, or list of dicts)
+            dataset: Dataset name (optional)
+            
+        Returns:
+            Generated response text
+        """
+        # Load model if needed
+        self._load_model_if_needed()
+        
+        # Handle different input types
+        if isinstance(message, str):
+            # Simple text input
+            return self._generate_text_response(message)
+        elif isinstance(message, dict):
+            # Single dict
+            message = [message]
+        
+        # Preprocess message to handle URLs
+        processed = self.preprocess_message(message, dataset)
+        
+        if not processed['image_paths']:
+            # No images, text-only
+            return self._generate_text_response(processed['text'])
+        
+        # Has images, use ChemDFM-X inference
+        return self._generate_with_images(processed['text'], processed['image_paths'])
+    
+    def _generate_text_response(self, text: str) -> str:
+        """Generate response for text-only input."""
+        logger.warning("Text-only inference not fully implemented for ChemDFM-X")
+        return "Text-only inference not supported. Please provide an image."
+    
+    def _generate_with_images(self, text: str, image_paths: List[str]) -> str:
+        """
+        Generate response using ChemDFM-X with images.
+        
+        Args:
+            text: Input text/prompt
+            image_paths: List of image file paths
+            
+        Returns:
+            Generated response text
+        """
+        try:
+            # Dynamically import ChemDFM-X inference utilities
+            from infer.constants import (
+                MOLSTART, MOLEND, DEFAULT_PAD_TOKEN, DEFAULT_MM_START, 
+                DEFAULT_MM_END, DEFAULT_MM_TOKENS, MODALITY_LIST
+            )
+            from infer.prompts import prompt_input_normal as prompt_input
+            from infer.prepare_data import prepare_infer_data
+            from infer.utils import generate, text_answer_postprocess, to_device
+            
+            # Prepare data for ChemDFM-X inference
+            data_example = {
+                'instruction': text,
+                'input': '[MM_FILE_I]',  # Image input token
+                'mm_input_files': image_paths
+            }
+            
+            data = [data_example]
+            
+            # Prepare multimodal inputs
+            data, mm_embedding, mm_length = prepare_infer_data(data)
+            
+            # Build prompt
+            args = type('Args', (), {
+                'mm_input_format': 'only_mm',
+                'without_wrapping': False,
+                'num_beams': 1,
+                'max_new_tokens': self.max_new_tokens,
+                'input_file': ''  # Required by prompts
+            })()
+            
+            prompt = prompt_input(data[0], args, shorter=10000, conversational=False)
+            
+            logger.info(f"Generated prompt: {prompt}")
+            logger.info(f"Image paths: {image_paths}")
+            logger.info(f"Instruction: {text}")
+            
+            # Run inference using the response function logic
+            response_text = self._run_inference(
+                prompt, mm_embedding, mm_length, data[0]['modality']
+            )
+            
+            return response_text
+            
+        except torch.cuda.OutOfMemoryError:
+            logger.error("CUDA Out of Memory Error")
+            return "Input too long or model too large"
+        except Exception as e:
+            logger.error(f"Error during generation: {e}")
+            import traceback
+            traceback.print_exc()
+            return f"Error during generation: {str(e)}"
+    
+    def _run_inference(self, inputs: str, mm_embedding: dict, mm_length: dict, modality_list: list) -> str:
+        """
+        Run inference using ChemDFM-X model.
+        
+        Args:
+            inputs: Input prompt text
+            mm_embedding: Multimodal embeddings
+            mm_length: Multimodal length information
+            modality_list: List of modalities
+            
+        Returns:
+            Generated response text
+        """
+        from infer.constants import (
+            MOLSTART, MOLEND, DEFAULT_PAD_TOKEN, DEFAULT_MM_START, 
+            DEFAULT_MM_END, DEFAULT_MM_TOKENS, MODALITY_LIST
+        )
+        from infer.utils import generate, text_answer_postprocess, to_device
+        
+        if MOLSTART not in inputs or MOLEND not in inputs:
+            if MOLSTART in inputs or MOLEND in inputs:
+                logger.warning(f'{MOLSTART} and {MOLEND} token not matched.')
+            else:
+                logger.info('Processing with NO mm inputs.')
+            final_input = self.tokenizer(inputs, return_tensors="pt").to(self.device).input_ids
+            mm_masks = None
+            mm_inputs = None
+        else:
+            mm_pad_id = self.tokenizer.convert_tokens_to_ids([DEFAULT_PAD_TOKEN])[0]
+            mm_token_id = self.tokenizer.convert_tokens_to_ids([DEFAULT_MM_TOKENS])[0]
+            mm_start_id = self.tokenizer.convert_tokens_to_ids([DEFAULT_MM_START])[0]
+            mm_end_id = self.tokenizer.convert_tokens_to_ids([DEFAULT_MM_END])[0]
+
+            logger.info('Processing with mm inputs')
+            logger.info(f'Raw inputs: {inputs}')
+            
+            ############# Parse the wrapped MM_FILE_TOKENS into MM_TOKENS #############
+            inputs_split = inputs.split(MOLSTART)
+            input_text, input_smiles = inputs_split[0], []
+
+            try:
+                smiles_index = 0
+                for split in inputs_split[1:]:
+                    split_smiles, split_text = split.split(MOLEND)
+                    processed_smiles = ''
+
+                    for smiles_by_dot in split_smiles.split('.'):
+                        for smiles in smiles_by_dot.split('>'):
+                            if smiles != '':
+                                modality = modality_list[smiles_index]
+                                smiles_index += 1
+                                if modality == 'mol_figure_2d':
+                                    processed_smiles += DEFAULT_MM_START + DEFAULT_MM_TOKENS * (mm_length[smiles] * 73 - 1) + DEFAULT_MM_END + '1'
+                                elif modality == 'mol_ir' or modality == 'mol_ms' or modality == 'mol_geometry_3d' or modality == 'mol_graph_2d':
+                                    processed_smiles += DEFAULT_MM_START + DEFAULT_MM_TOKENS * mm_length[smiles] + DEFAULT_MM_END + '1'
+                                else:
+                                    raise ValueError(f'modality: {modality} not supported.')
+                                input_smiles.append(smiles)
+
+                            processed_smiles += '>'
+                        processed_smiles = processed_smiles[:-1] + '.'
+                    processed_smiles = processed_smiles[:-1]
+                    input_text += processed_smiles + split_text
+            except KeyError as e:
+                logger.error(f'Smiles {e} not found in input \'{inputs}\'')
+                return 'Smiles not found'
+            
+            logger.info(f'Processed inputs: {input_text}')
+
+            ###################### Prepare the tokens and masks #########################
+            final_input = self.tokenizer(input_text).input_ids
+            end_index = 0
+            while mm_end_id in final_input[end_index:]:
+                tmp = final_input[end_index:].index(mm_end_id)
+                end_index += tmp + 1
+                final_input = final_input[:end_index] + final_input[end_index + 2:]
+            final_input = torch.tensor([final_input], dtype=torch.long).to(self.device)
+
+            input_ids = final_input[0]
+            start_idx = torch.where(input_ids == mm_start_id)[0].tolist()
+            end_idx = torch.where(input_ids == mm_end_id)[0].tolist()
+
+            mm_masks = torch.zeros((len(MODALITY_LIST), input_ids.size(0)), dtype=torch.long).to(self.device)
+            for start, end, mod in zip(start_idx, end_idx, modality_list):
+                mod_idx = MODALITY_LIST.index(mod)
+                mm_masks[mod_idx][start] = 1
+                mm_masks[mod_idx][end] = 2
+                mm_masks[mod_idx][start + 1:end] = -1
+                input_ids[start:end + 1] = mm_pad_id
+
+            ##################### new mm_inputs for raw input ###########################
+            mm_data = mm_embedding
+            mm_inputs = {modality:[] for modality in MODALITY_LIST}
+
+            ##################### Special treatment for figure ##########################
+            start_idx = torch.where(mm_masks[2] == 1)[0].tolist()
+            end_idx = torch.where(mm_masks[2] == 2)[0].tolist()
+            assert len(start_idx) == len(end_idx)
+
+            is_all_smiles_found = True
+            for index, single_smiles in enumerate(input_smiles):
+                if single_smiles not in mm_data:
+                    from infer.utils import normalize_smiles
+                    single_smiles = normalize_smiles(single_smiles)
+
+                if single_smiles in mm_data:
+                    modality = modality_list[index]
+                    if modality == 'mol_figure_2d':
+                        mm_inputs[modality].append({'data_path': mm_data[single_smiles], 'index': 1})
+                        figure_idx_pos = torch.arange(start_idx.pop(0), end_idx.pop(0), 73)[1:]
+                        if len(figure_idx_pos) > 0:
+                            assert len(figure_idx_pos) > 1
+                            if mm_length[single_smiles] > 0:
+                                mm_masks[2][figure_idx_pos] = torch.arange(len(figure_idx_pos), dtype=torch.long, device=self.device) + 3
+                            else:
+                                mm_masks[2][figure_idx_pos[0]] = 3
+                                mm_masks[2][figure_idx_pos[1:]] = torch.arange(len(figure_idx_pos) - 1, dtype=torch.long, device=self.device) + 15
+                    else:
+                        mm_inputs[modality].append(mm_data[single_smiles])
+                else:
+                    is_all_smiles_found = False
+                    logger.error(f'smiles [{single_smiles}] not found in eval, ignore the sample')
+                    break
+
+            if not is_all_smiles_found:
+                raise ValueError('smiles not found, not handled')
+
+            ############### prepare modality data in encoder input structure ############
+            from infer.prepare_data import (
+                prepare_mol_figure_2d_data, prepare_mol_geometry_3d, 
+                prepare_mol_graph_2d, prepare_mol_ms, prepare_mol_ir
+            )
+            
+            for modality in MODALITY_LIST:
+                if len(mm_inputs[modality]) == 0:
+                    mm_inputs[modality] = None
+                    continue
+
+                if modality == 'mol_figure_2d':
+                    mm_inputs['mol_figure_2d'] = prepare_mol_figure_2d_data(mm_inputs[modality], mm_masks)
+                elif modality == 'mol_geometry_3d':
+                    mm_inputs['mol_geometry_3d'] = prepare_mol_geometry_3d(mm_inputs[modality], mm_masks)
+                elif modality == 'mol_graph_2d':
+                    mm_inputs['mol_graph_2d'] = prepare_mol_graph_2d(mm_inputs[modality], mm_masks)
+                elif modality == 'mol_ms':
+                    mm_inputs['mol_ms'] = prepare_mol_ms(mm_inputs[modality], mm_masks)
+                elif modality == 'mol_ir':
+                    mm_inputs['mol_ir'] = prepare_mol_ir(mm_inputs[modality], mm_masks)
+                else:
+                    raise ValueError(f'modality {modality} not supported')
+            
+            mm_inputs = to_device(mm_inputs, self.device)
+
+            # Add unsqueeze to support multi-modality in 1 prompt
+            mm_masks = mm_masks.unsqueeze(0)
+
+            logger.info(f'Origin input: {inputs}')
+
+        try:
+            gen_output = generate(self.model, self.tokenizer, final_input, mm_masks, mm_inputs, 
+                                num_beams=1, max_new_tokens=self.max_new_tokens, do_sample=False)
+        except torch.cuda.OutOfMemoryError:
+            return "Input too long"
+
+        post_func = text_answer_postprocess
+        logger.info(f"Generated output: {gen_output[0]}")
+        
+        return post_func(gen_output[0], cut_prefix=len(self.tokenizer.decode(final_input[0], skip_special_tokens=True)))
+    
+    def build_prompt(self, line, dataset):
+        """
+        Build custom prompt for a specific dataset.
+        
+        Args:
+            line: Data line from dataset (dict with 'image_url' or 'image' and 'question')
+            dataset: Dataset name
+            
+        Returns:
+            Message format suitable for generate_inner
+        """
+        # Extract image path/URL and question
+        if isinstance(line, dict):
+            image_url = line.get('image_url', '')
+            question = line.get('question', '')
+        elif hasattr(line, '__dict__'):
+            image_url = getattr(line, 'image_url', '')
+            question = getattr(line, 'question', '')
+        else:
+            image_url = ''
+            question = ''
+        
+        # Build message
+        message = []
+        
+        if image_url:
+            # Check if it's a URL or local path
+            if image_url.startswith('http://') or image_url.startswith('https://'):
+                # Download from URL to local path
+                try:
+                    local_path = self.download_image_from_url(image_url)
+                    message.append({'type': 'image', 'value': local_path})
+                except Exception as e:
+                    logger.error(f"Failed to download image from URL: {image_url}")
+                    logger.error(f"Error: {e}")
+                    # Skip this image if download fails
+            else:
+                # Local path
+                message.append({'type': 'image', 'value': image_url})
+        
+        if question:
+            message.append({'type': 'text', 'value': question})
+        
+        return message
