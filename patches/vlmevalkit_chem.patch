+"""
+Chemical Formula Recognition Dataset for U-MolRecBench-Wild.
+"""
+
+import pandas as pd
+
+from .image_base import ImageBaseDataset
+from ..smp import *
+from ..smp.file import get_intermediate_file_path
+
+
+class ChemFormulaRecognition(ImageBaseDataset):
+
+    TYPE = 'ChemFormula'
+
+    DATASET_URL = {
+        'chem': '',
+        'chem_graph_simple': '',
+        'chem_smiles': '',
+    }
+
+    DATASET_MD5 = {
+        'chem': None,
+        'chem_graph_simple': None,
+        'chem_smiles': None,
+    }
+
+    def build_prompt(self, line):
+        if isinstance(line, int):
+            line = self.data.iloc[line]
+
+        msgs = []
+
+        visual_example_idx = 1
+        has_numbered_examples = False
+
+        while True:
+            field_name = f'visual_example_{visual_example_idx}'
+            if field_name in line and pd.notna(line[field_name]) and line[field_name]:
+                visual_example_path = line[field_name]
+                msgs.append(dict(type='image', value=visual_example_path))
+                has_numbered_examples = True
+                visual_example_idx += 1
+            else:
+                break
+
+        if not has_numbered_examples and 'visual_example' in line and pd.notna(line['visual_example']) and line['visual_example']:
+            visual_example_path = line['visual_example']
+            msgs.append(dict(type='image', value=visual_example_path))
+
+        if self.use_image_url and 'image_url' in line and pd.notna(line['image_url']) and line['image_url']:
+            tgt_path = toliststr(line['image_url'])
+        elif self.meta_only:
+            tgt_path = toliststr(line['image_path'])
+        else:
+            tgt_path = self.dump_image(line)
+
+        if isinstance(tgt_path, list):
+            msgs.extend([dict(type='image', value=p) for p in tgt_path])
+        else:
+            msgs.append(dict(type='image', value=tgt_path))
+
+        if 'question' in line and not pd.isna(line['question']) and line['question'] != '':
+            question = line['question']
+        else:
+            raise ValueError("question is required")
+
+        msgs.append(dict(type='text', value=question))
+
+        return msgs
+
+    def evaluate(self, eval_file, **judge_kwargs):
+        return 1
