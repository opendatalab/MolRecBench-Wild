+CHEMDFM_X_ROOT = os.environ.get('CHEMDFM_X_ROOT', '/mnt/petrelfs/lilinye/githubProjects/ChemDFM-X')
+if os.path.exists(CHEMDFM_X_ROOT) and CHEMDFM_X_ROOT not in sys.path:
