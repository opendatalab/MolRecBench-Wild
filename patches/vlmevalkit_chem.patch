+"""
+ChemVLM-26B Model Chat Implementation
+Based on the original test_chemvlm.py script
+"""
+
+import torch
+import torchvision.transforms as T
+from PIL import Image
+from transformers import AutoTokenizer, AutoModel
+from torchvision.transforms.functional import InterpolationMode
+
+from .utils import load_image, build_transform, dynamic_preprocess
+from ..base import BaseModel
+from ...dataset import DATASET_MODALITY
+from ...smp import *
+
+IMAGENET_MEAN = (0.485, 0.456, 0.406)
+IMAGENET_STD = (0.229, 0.224, 0.225)
+
+
+class ChemVLMChat(BaseModel):
+    """ChemVLM-26B Chat Model"""
+    
+    INSTALL_REQ = False
+    INTERLEAVE = True
+    
+    def __init__(self,
+                 model_path='AI4Chem/ChemVLM-26B',
+                 image_size=448,
+                 max_num=6,
+                 device_map='auto',
+                 torch_dtype=torch.bfloat16,
+                 **kwargs):
+        """
+        Initialize ChemVLM-26B model.
+        
+        Args:
+            model_path: Path to the model
+            image_size: Image size for processing (default: 448)
+            max_num: Maximum number of image tiles (default: 6)
+            device_map: Device mapping strategy ('auto' or 'cuda')
+            torch_dtype: Torch data type (default: bfloat16)
+            **kwargs: Generation config parameters
+        """
+        super().__init__()
+        
+        self.model_path = model_path
+        self.image_size = image_size
+        self.max_num = max_num
+        self.device = 'cuda' if torch.cuda.is_available() else 'cpu'
+        
+        # Load model
+        print(f"Loading ChemVLM model from {model_path}...")
+        self.model = AutoModel.from_pretrained(
+            model_path,
+            torch_dtype=torch_dtype,
+            low_cpu_mem_usage=True,
+            trust_remote_code=True,
+            device_map=device_map
+        ).eval()
+        
+        # Load tokenizer
+        self.tokenizer = AutoTokenizer.from_pretrained(
+            model_path,
+            trust_remote_code=True
+        )
+        
+        # Generation config
+        self.kwargs = kwargs
+        if 'max_new_tokens' not in self.kwargs:
+            self.kwargs['max_new_tokens'] = 512
+        if 'num_beams' not in self.kwargs:
+            self.kwargs['num_beams'] = 1
+        if 'do_sample' not in self.kwargs:
+            self.kwargs['do_sample'] = False
+        
+        print(f"ChemVLM model loaded successfully on {self.device}")
+    
+    def set_max_num(self, dataset):
+        """Set max_num based on dataset requirements."""
+        self.total_max_num = 64
+        if dataset is None:
+            self.max_num = 6
+            return
+        
+        # High-resolution datasets
+        res_12_datasets = ['ChartQA_TEST', 'MMMU_DEV_VAL', 'MMMU_TEST', 'MME-RealWorld',
+                           'VCR_EN', 'VCR_ZH', 'OCRVQA', 'BMMR']
+        res_18_datasets = ['DocVQA_VAL', 'DocVQA_TEST', 'DUDE', 'MMLongBench_DOC', 'SLIDEVQA']
+        res_24_datasets = ['InfoVQA_VAL', 'InfoVQA_TEST', 'OCRBench', 'HRBench4K', 'HRBench8K']
+        
+        if DATASET_MODALITY(dataset) == 'VIDEO':
+            self.max_num = 1
+        elif listinstr(res_12_datasets, dataset):
+            self.max_num = 12
+        elif listinstr(res_18_datasets, dataset):
+            self.max_num = 18
+        elif listinstr(res_24_datasets, dataset):
+            self.max_num = 24
+        else:
+            self.max_num = 6
+    
+    def generate_inner(self, message, dataset=None):
+        """
+        Generate response based on input message.
+        
+        Args:
+            message: List of dicts with 'type' and 'value' keys
+            dataset: Dataset name (optional)
+        
+        Returns:
+            str: Generated response
+        """
+        # Set max_num based on dataset
+        self.set_max_num(dataset)
+        
+        # Extract text prompt
+        prompt = '\n'.join([x['value'] for x in message if x['type'] == 'text'])
+        
+        # Extract image paths
+        image_paths = [x['value'] for x in message if x['type'] == 'image']
+        image_num = len(image_paths)
+        
+        if image_num == 0:
+            # No image, just text
+            pixel_values = None
+        elif image_num == 1:
+            # Single image
+            pixel_values = load_image(
+                image_paths[0],
+                input_size=self.image_size,
+                max_num=self.max_num
+            ).to(self.device).to(torch.bfloat16)
+        else:
+            # Multiple images
+            pixel_values_list = []
+            for img_path in image_paths:
+                pixel_values_list.append(
+                    load_image(
+                        img_path,
+                        input_size=self.image_size,
+                        max_num=self.max_num
+                    ).to(self.device).to(torch.bfloat16)
+                )
+            pixel_values = torch.cat(pixel_values_list, dim=0)
+        
+        # Prepare generation config
+        generation_config = dict(
+            num_beams=self.kwargs.get('num_beams', 1),
+            max_new_tokens=self.kwargs.get('max_new_tokens', 512),
+            do_sample=self.kwargs.get('do_sample', False),
+        )
+        
+        # Add other generation parameters if provided
+        for key in ['temperature', 'top_p', 'top_k', 'repetition_penalty']:
+            if key in self.kwargs:
+                generation_config[key] = self.kwargs[key]
+        
+        # Generate response
+        with torch.no_grad():
+            if pixel_values is None:
+                # Text-only generation (if supported)
+                response = self.model.chat(
+                    self.tokenizer,
+                    pixel_values=None,
+                    question=prompt,
+                    generation_config=generation_config
+                )
+            else:
+                response = self.model.chat(
+                    self.tokenizer,
+                    pixel_values=pixel_values,
+                    question=prompt,
+                    generation_config=generation_config
+                )
+        
+        # Handle tuple response (response, history)
+        if isinstance(response, tuple):
+            response = response[0]
+        
+        return response
+
