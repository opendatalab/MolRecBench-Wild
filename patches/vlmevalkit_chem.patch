+                os.environ['HUGGINGFACE_HUB_CACHE'] = default_cache_dir
+                logger.info(f"Using default HuggingFace cache directory: {default_cache_dir}")
+        
+        # Will be initialized lazily
+        self.tokenizer = None
+        self.model = None
+        self.device = None
+        self._model_loaded = False
+        
+        # Import ChemDFM-X dependencies when needed
+        self._import_chemdfm_x()
+    
+    def _import_chemdfm_x(self):
+        """Import ChemDFM-X dependencies."""
+        try:
+            # Dynamically import to avoid errors if ChemDFM-X is not installed
+            from dschat.utils.utils import load_hf_tokenizer
+            from dschat.utils.model.model_utils_figure import create_hf_model
+            from models.modeling_chemdfm_defaultmm_lora import ChemDFMMMForPreTraining
+            
+            self.load_hf_tokenizer = load_hf_tokenizer
+            self.create_hf_model = create_hf_model
+            self.ChemDFMMMForPreTraining = ChemDFMMMForPreTraining
+            self._dependencies_loaded = True
+        except ImportError as e:
+            logger.error(f"Failed to import ChemDFM-X dependencies: {e}")
+            logger.error(f"Please ensure CHEMDFM_X_ROOT is set correctly: {CHEMDFM_X_ROOT}")
+            self._dependencies_loaded = False
+    
+    def _load_model_if_needed(self):
+        """Lazy load the model."""
+        if self._model_loaded:
+            return
+        
+        if not self._dependencies_loaded:
+            raise ImportError("ChemDFM-X dependencies not loaded. Check CHEMDFM_X_ROOT.")
+        
+        logger.info("Loading ChemDFM-X tokenizer...")
+        self.tokenizer = self.load_hf_tokenizer(self.model_path, fast_tokenizer=True)
+        
+        logger.info("Loading ChemDFM-X model...")
+        self.device = torch.device("cuda:0") if torch.cuda.is_available() else torch.device("cpu")
