+"""
+ChemDFM-X Model Integration for VLMEvalKit
+
+This module integrates ChemDFM-X, a multimodal chemistry model, into VLMEvalKit.
+It supports inference with images from URLs by downloading them to temporary paths.
+
+Usage:
+    model = ChemDFM_X(model_path="OpenDFM/ChemDFM-X-v1.0-13B")
+    
+    # Using local image
+    result = model.generate_inner([
+        {'type': 'image', 'value': '/path/to/image.png'},
+        {'type': 'text', 'value': 'What is the SMILES notation?'}
+    ])
+    
+    # Using image URL (will be automatically downloaded)
+    result = model.generate_inner([
+        {'type': 'image', 'value': 'https://example.com/image.png'},
