diff --git a/vlmeval/api/mathpix.py b/vlmeval/api/mathpix.py
new file mode 100644
index 0000000..28fb3ac
--- /dev/null
+++ b/vlmeval/api/mathpix.py
@@ -0,0 +1,233 @@
+import json
+import os
+import re
+
+import requests
+
+from .base import BaseAPI
+from ..smp import *
+
+
+# HTTP status code constants
+HTTP_OK_MIN = 200
+HTTP_OK_MAX = 299
+
+
+class Mathpix(BaseAPI):
+    """
+    Mathpix OCR model wrapper for VLMEvalKit.
+    
+    This model uses Mathpix OCR API to recognize STEM document content, including
+    math, text, tables, and chemistry diagrams. Can extract SMILES notation for
+    chemical structures.
+    
+    Requires environment variables:
+        MATHPIX_APP_ID: Your Mathpix app ID
+        MATHPIX_APP_KEY: Your Mathpix app key
+    """
+    
+    is_api: bool = True
+    INSTALL_REQ = False
+    
+    def __init__(
+        self,
+        app_id: str = None,
+        app_key: str = None,
+        retry: int = 5,
+        verbose: bool = False,
+        timeout: int = 60,
+        include_smiles: bool = True,
+        include_latex: bool = True,
+        include_text: bool = True,
+        **kwargs
+    ):
+        """
+        Initialize Mathpix model.
+        
+        Args:
+            app_id: Mathpix app ID (defaults to MATHPIX_APP_ID env var)
+            app_key: Mathpix app key (defaults to MATHPIX_APP_KEY env var)
+            retry: Number of retries on failure
+            verbose: Whether to print verbose logs
+            timeout: Request timeout in seconds
+            include_smiles: Whether to request SMILES format
+            include_latex: Whether to request LaTeX format
+            include_text: Whether to request text format
+            **kwargs: Additional arguments for BaseAPI
+        """
+        # Get credentials from environment or arguments
+        self.app_id = app_id or os.environ.get('MATHPIX_APP_ID')
+        self.app_key = app_key or os.environ.get('MATHPIX_APP_KEY')
+        
+        assert self.app_id is not None, (
+            'Please set MATHPIX_APP_ID environment variable or pass app_id argument'
+        )
+        assert self.app_key is not None, (
+            'Please set MATHPIX_APP_KEY environment variable or pass app_key argument'
+        )
+        
+        self.timeout = timeout
+        self.include_smiles = include_smiles
+        self.include_latex = include_latex
+        self.include_text = include_text
+        
+        # Build formats list
+        formats = []
+        if self.include_text:
+            formats.append('text')
+        if self.include_latex:
+            formats.append('latex_styled')
+        if self.include_smiles:
+            formats.append('smiles')
+        
+        self.formats = formats
+        
+        super().__init__(
+            retry=retry,
+            verbose=verbose,
+            fail_msg='Failed to obtain answer via Mathpix API.',
+            **kwargs
+        )
+        
+        self.logger.info(f'Using Mathpix API with app_id: {self.app_id[:10]}...')
+    
+    def extract_text_from_message(self, message):
+        """
+        Extract text prompt from message.
+        
+        Args:
+            message: Input message (list of dicts)
+            
+        Returns:
+            str: Extracted text content
+        """
+        text_parts = []
+        for item in message:
+            if item.get('type') == 'text':
+                text_parts.append(item.get('value', ''))
+        return ' '.join(text_parts) if text_parts else None
+    
+    def extract_smiles_from_text(self, text):
+        """
+        Extract SMILES notation from text.
+        
+        Args:
+            text: Text that may contain SMILES in format <smiles>...</smiles>
+            
+        Returns:
+            str: Extracted SMILES string, or None if not found
+        """
+        if text is None or not isinstance(text, str):
+            return ''
+        
+        # Match <smiles>...</smiles> format
+        match = re.search(r'<smiles>(.*?)</smiles>', text, re.IGNORECASE)
+        if match:
+            return match.group(1).strip()
+        
+        # If text doesn't contain tags, assume it's already SMILES
+        # (for backward compatibility with direct SMILES response)
+        # Return the string itself (even if empty)
+        return text.strip()
+    
+    def is_url(self, path_or_url):
+        """
+        Check if the input is a URL.
+        
+        Args:
+            path_or_url: String that might be a URL or file path
+            
+        Returns:
+            bool: True if it's a URL, False otherwise
+        """
+        return isinstance(path_or_url, str) and (
+            path_or_url.startswith('http://') or 
+            path_or_url.startswith('https://')
+        )
+    
+    def generate_inner(self, inputs, **kwargs):
+        """
+        Generate response using Mathpix API.
+        
+        Args:
+            inputs: Preprocessed message (list of dicts)
+            **kwargs: Additional arguments
+            
+        Returns:
+            tuple: (ret_code, answer, response)
+                ret_code: 0 if success, non-zero if failed
+                answer: Extracted answer string
+                response: HTTP response object
+        """
+        # Find the first image in the inputs
+        image_input = None
+        for item in inputs:
+            if item.get('type') == 'image':
+                image_input = item.get('value')
+                break
+        
+        if image_input is None:
+            return -1, 'No image found in input', None
+        
+        # Extract text prompt if any
+        # text_prompt = self.extract_text_from_message(inputs)
+        
+        # Prepare headers
+        headers = {
+            'app_id': self.app_id,
+            'app_key': self.app_key,
+            'Content-type': 'application/json'
+        }
+        
+        # Check if input is URL or file path
+        assert self.is_url(image_input), 'Image input must be a URL'
+            # Use URL-based request
+        data = {
+            'src': image_input,
+            "rm_spaces": True,
+            "include_smiles": True
+        }
+            
+        try:
+            response = requests.post(
+                'https://api.mathpix.com/v3/text',
+                headers=headers,
+                json=data,
+                # timeout=self.timeout
+            )
+        except Exception as err:
+            if self.verbose:
+                self.logger.error(f'Request failed: {err}')
+            return -1, f'Request failed: {str(err)}', None
+        
+        ret_code = response.status_code
+        # Convert HTTP status to ret_code (0 for success)
+        ret_code = 0 if (HTTP_OK_MIN <= ret_code <= HTTP_OK_MAX) else ret_code
+        
+        # Extract answer
+        try:
+            resp_json = response.json()
+            smiles_extracted = self.extract_smiles_from_text(resp_json['text'])
+            answer = smiles_extracted if smiles_extracted else resp_json['text']
+                
+        except Exception as err:
+            if self.verbose:
+                self.logger.error(f'Failed to parse response: {err}')
+                self.logger.error(f'Response: {response.text}')
+        
+        return ret_code, answer, response
+    
+    def generate(self, message, dataset=None):
+        """
+        Generate response for the given message.
+        
+        Args:
+            message: Input message (can be str, dict, or list)
+            dataset: Dataset name (not used in Mathpix)
+            
+        Returns:
+            str: Generated response
+        """
+        return super(Mathpix, self).generate(message)
+
+
