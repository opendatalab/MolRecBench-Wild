+    def __init__(self, 
+                 model_path: str = "OpenDFM/ChemDFM-X-v1.0-13B",
+                 max_new_tokens: int = 1024,
+                 device_map=None,
+                 cache_dir: str = None,
+                 **kwargs):
+        """
+        Initialize ChemDFM-X model.
+        
+        Args:
+            model_path: Path to the ChemDFM-X model (local or HuggingFace model ID)
+            max_new_tokens: Maximum number of new tokens to generate
+            device_map: Device mapping for model loading (e.g., 'auto')
+            cache_dir: Directory to cache HuggingFace models. If None, uses environment variable
+                       HUGGINGFACE_HUB_CACHE or HF_HOME, or default ~/.cache/huggingface/hub
+            **kwargs: Additional arguments
+        """
+        super().__init__()
+        
+        self.model_path = model_path
+        self.max_new_tokens = max_new_tokens
+        self.device_map = device_map
+        self.kwargs = kwargs
+        
+        # Set HuggingFace cache directory
+        if cache_dir is not None:
